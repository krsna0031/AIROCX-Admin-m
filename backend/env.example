# ═══════════════════════════════════════════════
# AIROCX Backend — Environment Variables
# ═══════════════════════════════════════════════
# Copy this file to .env and fill in your values

# DATABASE_URL:
# ─ Local SQLite (zero config, default):
#     sqlite:///./airocx.db
# ─ Production PostgreSQL (Render, Supabase, etc):
#     postgresql://username:password@hostname:port/database_name
DATABASE_URL=sqlite:///./airocx.db

# Security — change these in production!
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
ENVIRONMENT=development
FRONTEND_URLS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
ACCESS_TOKEN_EXPIRE_HOURS=8
MAX_IMAGE_BYTES=2097152

# CORS — set to your Vercel frontend URL in production
# Use * for local development, exact URL for production
FRONTEND_URL=*
# Example: FRONTEND_URL=https://airocx.vercel.app
