# ═══════════════════════════════════════════════
# AIROCX Project — .gitignore
# ═══════════════════════════════════════════════

# Dependencies
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Environment files (NEVER commit secrets)
.env
.env.*
!env.example

# Build outputs
build/
dist/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Testing
coverage/
.pytest_cache/

# Temp files
tmp/
temp/
*.tmp

# Lock files (keep package-lock.json for Vercel)
yarn.lock

# Cache
.ruff_cache/
.cache/

# Project specific
airocx-temp/
*.zip

# Python virtual environments
venv/
.venv/
backend/venv/

# SQLite database files (regenerated on startup)
*.db
*.db-journal
airocx.db

# Vercel
.vercel/

# Render
.render/

# Emergent / Gemini local state
.emergent/
memory/
